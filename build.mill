//| mill-version: 1.1.9

import mill._, scalalib._, scalajslib._, scalanativelib._, scalafmt._, publish._
import mill.api.Task.Simple

val scala3 = "3.9.0"
val scalaNative = "0.5.12"

object thirdparty:
  val oslib = mvn"com.lihaoyi::os-lib::0.11.6"
  val geny = mvn"com.lihaoyi::geny::1.1.1"
  val utest = mvn"com.lihaoyi::utest::0.9.1"
  val ujson = mvn"com.lihaoyi::ujson::4.4.0"
  val yamlesque = mvn"io.crashbox::yamlesque::0.5.1"
  val sconfig = mvn"org.ekrich::sconfig::1.12.0"

  val javatime = mvn"io.github.cquiroz::scala-java-time::2.6.0"
  val javatimeTzdb = mvn"io.github.cquiroz::scala-java-time-tzdb::2.6.0"

trait Publish extends PublishModule:

  /** The version of this project, derived from git.
    *
    * It is the output of `git describe`. If the working tree is dirty, the
    * current timestamp is appended, so that every build of uncommitted changes
    * gets a unique version.
    */
  def publishVersion = Task.Input:
    val dirtyMarker = "-dirty"
    val result = os
      .proc("git", "describe", "--tags", "--always", "--dirty=" + dirtyMarker)
      .call(cwd = Task.ctx().workspace, check = false, stderr = os.Pipe)

    val described =
      if result.exitCode == 0 then result.out.trim().stripPrefix("v")
      else "0.0.0" // no commits yet

    if described.endsWith(dirtyMarker) then
      val timestamp = java.time.format.DateTimeFormatter
        .ofPattern("yyyyMMddHHmmss")
        .withZone(java.time.ZoneOffset.UTC)
        .format(java.time.Instant.now())
      s"${described.dropRight(dirtyMarker.length)}-$timestamp"
    else described

  def pomSettings = PomSettings(
    description = "A configuration parsing library for Scala 3",
    organization = "io.crashbox",
    url = "https://github.com/jodersky/autoset",
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github("jodersky", "autoset"),
    developers = Seq(
      Developer("jodersky", "Jakob Odersky", "https://github.com/jodersky")
    )
  )

trait AutosetModule extends ScalaModule with ScalafmtModule with Publish:
  def moduleDir = super.moduleDir / os.up
  def scalaVersion = scala3
  def scalacOptions = Seq("-deprecation", "-feature", "-explain-cyclic")
  def mvnDeps = Seq(
    thirdparty.oslib,
    thirdparty.geny,
    thirdparty.ujson,
    thirdparty.yamlesque,
    thirdparty.sconfig
  )

  trait Tests extends ScalaTests:
    def scalacOptions = Seq("-explain")
    def testFramework = "utest.runner.Framework"
    def mvnDeps = Seq(
      thirdparty.utest
    )

object ini extends Module:
  trait IniModule extends AutosetModule:
    def artifactName = "autoset-ini"
    def mvnDeps = Seq()

    trait IniTests extends Tests:
      def mvnDeps = super.mvnDeps() ++ Seq(thirdparty.oslib, thirdparty.ujson)

  object jvm extends IniModule:
    def sourcesFolders = Seq("src", "src-jvm")
    object test extends IniTests

  object native extends IniModule with ScalaNativeModule:
    def sourcesFolders = Seq("src", "src-native")
    def scalaNativeVersion = scalaNative
    object test extends IniTests with ScalaNativeTests:
      def nativeLinkStubs = true

object autoset extends Module:
  object jvm extends AutosetModule:
    def sourcesFolders = Seq("src", "src-jvm")
    def artifactName = "autoset"
    def moduleDeps = Seq(ini.jvm)
    object test extends Tests

    // Compiles uses of autoset's macros with -Xcheck-macros, to catch malformed
    // macro expansions. This can't be enabled in `test`, since utest's own
    // macros fail the check.
    object macrocheck extends ScalaModule:
      def scalaVersion = scala3
      def scalacOptions = Seq("-Xcheck-macros")
      def moduleDeps = Seq(jvm)

  object native extends AutosetModule with ScalaNativeModule:
    def sourcesFolders = Seq("src", "src-native")
    def artifactName = "autoset"
    def moduleDeps = Seq(ini.native)
    def scalaNativeVersion = scalaNative
    def mvnDeps = super.mvnDeps() ++ Seq(thirdparty.javatime, thirdparty.javatimeTzdb)
    object test extends Tests with ScalaNativeTests:
      def nativeLinkStubs = true

object examples extends Module:
  trait ExampleModule extends ScalaModule:

    def scalaVersion = scala3
    def moduleDeps = Seq(autoset.jvm)
    // run examples from their own directory, so that they find their config files
    def forkWorkingDir = Task { moduleDir }

    def exampleFile = Task.Input:
      ExampleFile.fromFile(
        moduleDir / "src" / "app.scala"
      )

    def test() = Task.Command:
      for (invocation0, expected) <- exampleFile().usageTests do
        val invocation = invocation0
          .replaceAll("\\$\\s+", "")
          .replaceAll("\\./app", assembly().path.toString)

        Task.log.info(s"Running test: ${invocation}")

        val result = os.proc("bash", "-o", "errexit", "-c", invocation).call(
          cwd = moduleDir,
          stdin = os.Inherit,
          stdout = os.Pipe,
          stderr = os.Pipe,
          mergeErrIntoOut = true,
          check = false,
          env = Map(
            // suppress warnings on java 25 about illegal reflective access (TODO:
            // remove once we upgrade to a newer scala version with fixed warnings)
            "JAVA_OPTS" -> "--enable-native-access=ALL-UNNAMED --illegal-native-access=allow  --sun-misc-unsafe-memory-access=allow"
          )
        )

        val output = result.out.text()

        val outLines = output.linesIterator.map(_.trim()).mkString("\n")
        val expectedLines = expected.linesIterator.map(_.trim()).mkString("\n")

        def compareLines(expected: String, output: String): Boolean =
          expected.equalsIgnoreCase(output)

        var matches = true
        val outIter = output.linesIterator.buffered
        val expectedIter = expected.linesIterator.buffered
        while expectedIter.hasNext && matches do
          val expectedLine = expectedIter.next().trim()
          if expectedLine == "..." then
            if expectedIter.hasNext then
              val nextExpected = expectedIter.head.trim()
              var found = false
              while outIter.hasNext && !found do
                if compareLines(outIter.head.trim(), nextExpected) then found = true
                else outIter.next()
              if !found then matches = false
          else
            if outIter.hasNext then
              if !compareLines(outIter.next().trim(), expectedLine) then matches = false
            else
              matches = false


        assert(
          matches,
          s"""|For invocation:
              |${invocation}
              |Expected:
              |---
              |${expectedLines}
              |---
              |Got:
              |---
              |${output}
              |---
              |""".stripMargin
        )
  end ExampleModule

  object demo extends ExampleModule
  object formats extends ExampleModule
  object dirs extends ExampleModule
  object valuedirs extends ExampleModule
  object overrides extends ExampleModule
  object origins extends ExampleModule
  object readers extends ExampleModule
  object derivation extends ExampleModule
  object customreaders extends ExampleModule
  object errors extends ExampleModule
  object configtraits extends ExampleModule
  object settings extends ExampleModule

  val all = Seq(
    demo,
    formats,
    dirs,
    valuedirs,
    overrides,
    origins,
    readers,
    derivation,
    customreaders,
    errors,
    configtraits,
    settings
  )

// update actual readme from snippets in example apps
def readme() = Task.Command:
  val Include = """\[include:(.+)\]""".r

  val allExamples = Task.sequence(examples.all.map(_.exampleFile))()
  val snippetMap = examples.all.map(_.moduleDir.last).zip(allExamples).toMap

  val lines = os.read.lines(Task.ctx().workspace / "readme.pre.md")
  os.write.over(
    Task.ctx().workspace / "README.md",
    lines.map:
      case Include(name) =>
        snippetMap(name).markdown

      case other => other
    .mkString("\n")
  )

/** A runnable scala file, whose content can also be rendered as markdown.
  *
  * The idea is to write example code that serves multiple purposes:
  * documentation as markdown and runnable example code, as well as testable
  * code.
  *
  * The source files work the following way:
  * - they are regular .scala files, runnable via scala-cli
  * - comments within them will be extracted as markdown text
  * - scala code can be marked as snippets to be extracted as code blocks in
  *   markdown
  * - usage examples can be provided in special comment blocks, which also be
  *   rendered as snippets in markdown, and also be executed as tests to verify
  *   that the output is as expected
  */
case class ExampleFile(
  markdown: String,
  usageTests: Seq[(String, String)] = Seq.empty
) derives upickle.default.ReadWriter
object ExampleFile:
  def fromFile(
    path: os.Path,
    changeInvocation: String => String = s => s
  ) =
    val markdown = new StringBuilder
    val usageTests = collection.mutable.ListBuffer.empty[(String, String)]

    val lines = os.read(path).linesIterator

    var line = ""
    def readLine() = if lines.hasNext then line = lines.next() else line = null

    readLine()

    while line != null do
      if line.trim().startsWith("//snippet:start") then
        val startCol = line.indexOf("//snippet:start")
        readLine()
        markdown ++= "\n```scala\n"
        while line != null && !line.trim().startsWith("//snippet:end") do
          markdown ++= line.drop(startCol)
          markdown ++= "\n"
          readLine()

        markdown ++= "```\n"
        readLine()
      else if line.trim().startsWith("//include:") then
        val fp = line.drop(10)
        markdown ++= os.read(path / os.up / os.RelPath(fp))
        readLine()
      else if line.trim().startsWith("//") && !line.trim().startsWith("//>") then
        val startCol = line.indexOf("//") + 3
        markdown ++= line.drop(startCol)
        markdown ++= "\n"
        readLine()
      else if line.trim().startsWith("/* usage") then
        val isSnippet = line.trim().startsWith("/* usage snippet")
        val startCol = line.indexOf("/* usage")
        readLine()

        if line == null then sys.error("expected at least one line after usage")
        var invocation = line.drop(startCol)
        if invocation.endsWith("\\") then
          invocation = invocation.dropRight(1)
          readLine()
          while line != null && line.endsWith("\\") do
            invocation += " " + line.dropRight(1).trim()
            readLine()
          invocation += " " + line.trim()
          readLine()
        else
          readLine()

        if isSnippet then
          markdown ++= "\n```\n"
          markdown ++= changeInvocation(invocation)
          markdown ++= "\n"

        var expected = ""
        while line != null && !line.trim().startsWith("*/") do
          expected += line.drop(startCol)
          expected += "\n"
          if isSnippet then
            markdown ++= line.drop(startCol)
            markdown ++= "\n"
          readLine()
        readLine()
        if isSnippet then
          markdown ++= "```\n"
        usageTests += ((invocation, expected))

      else if line.isEmpty then
        markdown ++= "\n"
        readLine()
      else
        readLine()
    ExampleFile(markdown.toString, usageTests.toSeq)
